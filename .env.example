# ==============================================================================
# Sistema de Detección de Presencia mediante PIR y CSI Wi-Fi
# Configuración del Entorno
# ==============================================================================

# Telemetría de hardware mediante MQTT
DATA_SOURCE=mqtt
DEBUG=false

# Configuración del Broker MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=presence_backend_service

# Base de datos SQLite
DATABASE_URL=sqlite+aiosqlite:///./presence-hardware.db

# CORS para comunicación con el frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Referencia de Frontend: para cambiarlos, definir en frontend/.env.local.
# No se copia automáticamente desde este archivo al frontend.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/telemetry
