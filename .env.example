# ==============================================================================
# Sistema de Detección de Presencia mediante PIR y CSI Wi-Fi
# Configuración del Entorno
# ==============================================================================

# Fuente de datos: 'mock' (simulación interna) o 'mqtt' (broker hardware ESP32)
DATA_SOURCE=mock

# Configuración del Broker MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=presence_backend_service

# Base de datos SQLite
DATABASE_URL=sqlite+aiosqlite:///./presence.db

# CORS para comunicación con el frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Configuración de Frontend (se replica en frontend/.env)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/telemetry
